# Rust build output
/target/

# Local environment and credentials
.env
.env.*
!.env.example

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Python profiling-tool caches
__pycache__/

# Local evaluation configurations and reports
/evals/*.local.json
/evals/reports/

# Logs and temporary files
*.log
*.tmp

# Fuzz builds, generated corpus and crashes stay local; curated seeds are tracked.
/fuzz/target/
/fuzz/artifacts/
/fuzz/generated-corpus/
